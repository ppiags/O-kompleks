# ---------------------------------------------------------------------------
# AI CRM Assistant — пример конфигурации окружения.
# Скопируйте в .env и заполните только то, что нужно.
# .env в git не коммитится (см. .gitignore).
# ---------------------------------------------------------------------------

# Какой провайдер использовать: auto | mock | openai | deepseek
# auto (по умолчанию): если задан ключ OpenAI/DeepSeek — используется он,
# иначе автоматически включается mock. Приложение работает и без .env.
AI_PROVIDER=auto

# --- OpenAI ---------------------------------------------------------------
# Серверная переменная. НЕ добавляйте префикс VITE_ — иначе ключ попадёт
# в клиентский bundle.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek -------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Общие настройки провайдеров -----------------------------------------
# Таймаут запроса к LLM, мс
AI_REQUEST_TIMEOUT_MS=30000
# Температура генерации
AI_TEMPERATURE=0.3
